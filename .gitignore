# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Google service account credentials — never commit these
*-credentials.json
*-service-account.json
lion-jobs-agency-system-*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example is the setup template and must stay tracked;
# CLAUDE.md tells every new dev/agent session to copy it. Everything else
# (.env.local, .env, etc.) holds real secrets and stays ignored.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/

# Brainstorming companion (local mockups, not for commit)
.superpowers/

# Supabase CLI local link/cache state (machine-specific, not portable config)
supabase/.temp/
supabase/.branches/

# Local git worktrees (agent isolation)
.worktrees/
