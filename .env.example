# Copy to .env.local and fill in real values. Never commit .env.local — it is gitignored.

# ── Supabase (primary database) ─────────────────────────────────────
# Get from: Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Google Drive (CV file storage) ──────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# Paste the full private key. In .env.local replace literal newlines with \n.
# In Vercel, paste the key as-is (multiline) in the env var editor.
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
# Parent folder in Drive where candidate CV sub-folders are created
GOOGLE_DRIVE_PARENT_FOLDER_ID=your-google-drive-folder-id

# ── Google OAuth (for /dashboard admin login) ──────────────────────
# Create at: https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Authorised redirect URIs: https://your-domain.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# NextAuth — generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_URL=https://your-domain.vercel.app
NEXTAUTH_SECRET=your-random-secret-at-least-32-chars

# Admin email — only this Gmail can access /dashboard
ADMIN_EMAIL=lionzawlwin@gmail.com

# Company Portal + Candidate Portal (Sprint 2) — signs the magic-link
# session cookie. Independent of NEXTAUTH_SECRET; a separate, unrelated
# auth system from staff/admin login. Generate with: openssl rand -base64 48
PORTAL_SESSION_SECRET=your-random-secret-at-least-32-chars

# ── Resend (email notifications) ────────────────────────────────────
# Sign up free at: https://resend.com — 3,000 emails/month
RESEND_API_KEY=re_your_resend_api_key
# Must be a verified domain in Resend. Or use: onboarding@resend.dev for testing.
RESEND_FROM_EMAIL=Lion Jobs Agency <jobs@yourdomain.com>

# ── Job publishing (GitHub Actions social post) ─────────────────────
PUBLISH_WEBHOOK_SECRET=your-publish-webhook-secret
GITHUB_ACTIONS_TOKEN=ghp_your-github-token
GITHUB_REPO=your-org/your-repo
SITE_URL=https://your-domain.vercel.app

# ── Supabase CLI (schema migrations — see supabase/MIGRATIONS.md) ──
# Personal access token from https://supabase.com/dashboard/account/tokens.
# Needed because `supabase login`'s browser OAuth flow doesn't work in
# non-TTY environments (CI, some agent sessions) — use this instead:
#   npx supabase login --token "$SUPABASE_ACCESS_TOKEN"
SUPABASE_ACCESS_TOKEN=sbp_your_personal_access_token

# ── Admin API key (for POST /api/jobs) ──────────────────────────────
ADMIN_KEY=your-admin-api-key

# ── Cron security ───────────────────────────────────────────────────
CRON_SECRET=your-cron-secret-here

# ── Sentry (exception capture) ──────────────────────────────────────
# Project DSN from https://sentry.io — leave unset to disable (Sentry.init is a no-op)
SENTRY_DSN=

# ── Phase 6 alerting (health-check notifications) ───────────────────
# Where cron-silence / failure-rate-spike alerts are sent. Leave unset to no-op.
ALERT_EMAIL=

# ── ARCHIVE — no longer read by application code ────────────────────
# These vars were used with Google Sheets + Make.com (removed in Supabase migration).
# Keep for historical reference; safe to delete from Vercel env.
# GOOGLE_SHEET_ID=
# GOOGLE_JOBS_TAB=
# GOOGLE_CANDIDATES_TAB=
# GOOGLE_COMPANIES_TAB=
# GOOGLE_FEEDBACK_TAB=
# MAKE_WEBHOOK_URL=
# MAKE_PUBLISH_WEBHOOK_URL=
# MAKE_EMPLOYER_WEBHOOK_URL=
