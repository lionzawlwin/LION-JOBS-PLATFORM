# =============================================================================
# Lion Jobs Platform — Local Environment Template
# =============================================================================
#
# HOW TO USE:
#   1. Copy this file:
#        cp env.local.template .env.local
#   2. Fill in each value below with your real credentials
#   3. Restart the dev server after editing:
#        npm run dev
#
# IMPORTANT: .env.local is already in .gitignore — it will never be committed.
#            This template file (env.local.template) is safe to commit.
#
# Without these values the app runs in "empty state" mode:
#   - Job listings page shows no jobs (no error, just empty)
#   - Dashboard shows no candidates
#   - Application form submits but the webhook call is skipped in dev
# Set all four variables to connect real Google Sheets + Make.com data.
# =============================================================================


# ── Google Sheets ─────────────────────────────────────────────────────────────

# Your Google Sheet's ID, found in its URL:
#   https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID_HERE/edit
GOOGLE_SHEET_ID=

# Email of the Google Cloud service account that has Editor access to the sheet.
# Example: lion-jobs@my-project-12345.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The private key from the service account's JSON key file.
# Open the downloaded JSON and copy the entire "private_key" value (including
# the -----BEGIN / -----END lines).
#
# IMPORTANT — newline encoding:
#   In the JSON file the key uses literal newlines.
#   In this .env.local file you must replace each newline with the two
#   characters \n  (a backslash followed by the letter n).
#
# Correct format (all on one line, \n for line breaks):
#   GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEpAIBAAKCAQ...\n-----END RSA PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=


# ── Make.com Webhook ──────────────────────────────────────────────────────────

# The webhook URL from your Make.com scenario's Custom Webhook trigger module.
# Example: https://hook.eu1.make.com/abcdef1234567890
#
# When this is empty in development, /api/apply returns { ok: true, dev: true }
# so the form submission flow still works end-to-end locally.
MAKE_WEBHOOK_URL=
